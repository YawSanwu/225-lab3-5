
FROM nginx:alpine

WORKDIR /usr/share/nginx/html

COPY default.conf /etc/nginx/conf.d/default.conf

RUN mkdir -p /usr/share/nginx/html/lab3-5

COPY index.html /usr/share/nginx/html/lab3-5/index.html
COPY style.css /usr/share/nginx/html/lab3-5/style.css
COPY robots.txt /usr/share/nginx/html/lab3-5/robots.txt
